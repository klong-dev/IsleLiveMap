<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HostRoot Condition="'$(HostRoot)' == ''">../..</HostRoot>
    <DefineConstants Condition="'$(ReleaseBaseline)' == 'true'">$(DefineConstants);RELEASE_BASELINE</DefineConstants>
    <DefineConstants Condition="'$(HostBinaryDirectory)' != ''">$(DefineConstants);ACCEPTANCE_BINARY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HostBinaryDirectory)' == ''">
    <ProjectReference Include="$(HostRoot)/src/TheIsleOverlay.LocalTelemetry/TheIsleOverlay.LocalTelemetry.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HostBinaryDirectory)' != ''">
    <Reference Include="TheIsleOverlay.Core"><HintPath>$(HostBinaryDirectory)/TheIsleOverlay.Core.dll</HintPath></Reference>
    <Reference Include="TheIsleOverlay.LocalTelemetry"><HintPath>$(HostBinaryDirectory)/TheIsleOverlay.LocalTelemetry.dll</HintPath></Reference>
  </ItemGroup>
</Project>
