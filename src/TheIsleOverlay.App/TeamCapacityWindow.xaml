<Window x:Class="TheIsleOverlay.App.TeamCapacityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhóm sinh tồn · Quy mô phòng" Width="510" Height="550" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0C211E" Foreground="#EAF4F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CapacityChoice" TargetType="Button">
            <Setter Property="Height" Value="102"/><Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="#16342E"/><Setter Property="BorderBrush" Value="#416C61"/>
            <Setter Property="Foreground" Value="#EAF4F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#84C7AF"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#E8CB88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#0C211E"><Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="QUY MÔ NHÓM SINH TỒN" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Số người tối đa trong phòng, tính cả bạn." Margin="0,8,0,4" FontSize="14" Foreground="#A7C3B9"/>
            <TextBlock x:Name="TierLabel" FontSize="12" Foreground="#E8CB88"/>
        </StackPanel>
        <UniformGrid x:Name="ChoicesPanel" Grid.Row="1" Columns="2" Rows="2" Height="224" VerticalAlignment="Center"/>
        <TextBlock x:Name="MessageLabel" Grid.Row="2" MinHeight="45" Margin="0,4,0,10" FontSize="14" Foreground="#E8CB88" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <Button Grid.Row="3" Content="HỦY" IsCancel="True" HorizontalAlignment="Right" Padding="24,9" Background="#16342E" Foreground="#EAF4F0" BorderBrush="#416C61"/>
    </Grid></Grid>
</Window>
