<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheIsleOverlay.Core\TheIsleOverlay.Core.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.EraGaming\TheIsleOverlay.EraGaming.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Gacha\TheIsleOverlay.Gacha.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.IslePilot\TheIsleOverlay.IslePilot.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.LocalTelemetry\TheIsleOverlay.LocalTelemetry.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Localization\TheIsleOverlay.Localization.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Origin\TheIsleOverlay.Origin.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Pandora\TheIsleOverlay.Pandora.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.ProClient\TheIsleOverlay.ProClient.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.TeamRelay\TheIsleOverlay.TeamRelay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GatewayMap.jpg" />
    <Resource Include="Assets\ProMapPreview.png" />
    <Resource Include="Assets\SetPointTip.png" />
    <Resource Include="Assets\MapZoneTip.png" />
    <Resource Include="Assets\GachaLogo.png" />
    <Resource Include="Assets\OriginLogo.png" />
    <Resource Include="Assets\ZaloChannelInvite.jpg" />
    <EmbeddedResource Include="Assets\GatewayMapLayers.json" />
    <!-- The `.vi` segment is part of the file name, not a satellite-resource
         culture. Keep the catalog in the main assembly so MutationCatalog can
         load it consistently in the published app and in tests. -->
    <EmbeddedResource Include="Assets\MutationCatalog.vi.json"
                      WithCulture="false"
                      LogicalName="TheIsleOverlay.App.Assets.MutationCatalog.vi.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>TheIsleOverlay.App.Program</StartupObject>
    <AssemblyName>IsleLiveMap</AssemblyName>
    <RootNamespace>TheIsleOverlay.App</RootNamespace>
    <Product>Isle Live Map</Product>
    <Description>Open-source live map overlay for The Isle Evrima.</Description>
    <Authors>klong-dev</Authors>
    <Version>2.1.2</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\IsleLiveMap.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
