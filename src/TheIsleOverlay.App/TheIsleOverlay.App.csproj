<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheIsleOverlay.Core\TheIsleOverlay.Core.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.EraGaming\TheIsleOverlay.EraGaming.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.IslePilot\TheIsleOverlay.IslePilot.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.LocalTelemetry\TheIsleOverlay.LocalTelemetry.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Pandora\TheIsleOverlay.Pandora.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.TeamRelay\TheIsleOverlay.TeamRelay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GatewayMap.jpg" />
    <Resource Include="Assets\cute_mouse.jpg" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>TheIsleOverlay.App.Program</StartupObject>
    <AssemblyName>IsleLiveMap</AssemblyName>
    <RootNamespace>TheIsleOverlay.App</RootNamespace>
    <Product>Isle Live Map</Product>
    <Description>Open-source live map overlay for The Isle Evrima.</Description>
    <Authors>klong-dev</Authors>
    <Version>1.2.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\IsleLiveMap.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
