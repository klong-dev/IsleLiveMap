<Window x:Class="TheIsleOverlay.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Live Map" Width="470" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="HomeBone" Color="#E9F4EE" />
        <SolidColorBrush x:Key="HomeMuted" Color="#7F9993" />
        <SolidColorBrush x:Key="HomeLine" Color="#35554F" />

        <Style x:Key="HomeChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AFC3BC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#35554F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#183631" />
                                <Setter Property="Foreground" Value="#F3FFF9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#265048" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource HomeChromeButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="#A50A211F" />
        </Style>

        <Style x:Key="SourceButton" TargetType="Button" BasedOn="{StaticResource HomeChromeButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#C50B2421" />
            <Setter Property="BorderBrush" Value="#486C64" />
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="#F2071716" BorderBrush="#6A58736C" BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.72" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#2F514B" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="#163C38" Stroke="#37D4C6" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD // LINK" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="  OPEN TELEMETRY CLIENT" Foreground="#5F7F77" FontFamily="Bahnschrift" FontSize="8" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource HomeChromeButton}" Content="—" Width="27" Height="23" Padding="0" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource HomeChromeButton}" Content="×" Width="27" Height="23" Padding="0" Margin="5,0,0,0" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,22,22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ISLE" Foreground="#66857D" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="LIVE MAP" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="42" FontWeight="Bold" Margin="-2,-7,0,0" />
                            <TextBlock Text="Minimap và chỉ số cá nhân cho The Isle Evrima." Foreground="{StaticResource HomeMuted}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="68" Height="68" CornerRadius="34" BorderBrush="#3B665E" BorderThickness="1" VerticalAlignment="Top">
                            <Grid>
                                <Ellipse Width="45" Height="45" Stroke="#385F58" StrokeThickness="1" />
                                <Path Data="M34,12 L43,37 L34,31 L25,37 Z" Fill="#E9F4EE" Stroke="#37D4C6" StrokeThickness="1" />
                                <Ellipse Width="5" Height="5" Fill="#E7B74E" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="#35554F" Margin="0,18,0,16" />

                    <TextBlock Text="TỪ NGƯỜI LÀM TOOL" Foreground="#6F9188" FontFamily="Bahnschrift SemiCondensed" FontSize="9" Margin="0,0,0,8" />

                    <Button Style="{StaticResource LinkButton}" Tag="https://www.facebook.com/klong.dev" Click="OpenLink_Click" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="#37D4C6" RadiusX="1" RadiusY="1" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock Text="K-LONG.DEV / FACEBOOK" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Thiết kế tool game · tool auto · website · shop bán hàng · bot tự động" Foreground="{StaticResource HomeMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" Foreground="#37D4C6" FontSize="18" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource LinkButton}" Tag="https://www.youtube.com/@longhoangkim2246" Click="OpenLink_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="#E7B74E" RadiusX="1" RadiusY="1" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock Text="LONG HOÀNG KIM / YOUTUBE" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Video, dự án và các bản cập nhật mới." Foreground="{StaticResource HomeMuted}" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↗" Foreground="#E7B74E" FontSize="18" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Background="#B7132522" BorderBrush="#4D746B" BorderThickness="1" CornerRadius="3" Padding="14,12" Margin="0,14,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PROJECT PHI LỢI NHUẬN · OPEN SOURCE" Foreground="#37D4C6" FontFamily="Bahnschrift SemiCondensed" FontSize="9" />
                                <TextBlock Text="Xin 1 star GitHub" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="18" Margin="0,2,0,0" />
                                <TextBlock Text="* Chia sẻ thêm cho người khác để Long được nhiều người biết đến hơn. Source công khai nên bạn có thể tự kiểm tra virus và cách app vận hành." Foreground="#91A9A2" FontSize="10" TextWrapping="Wrap" MaxWidth="290" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource HomeChromeButton}" Tag="https://github.com/klong-dev/IsleLiveMap" Click="OpenLink_Click"
                                    Content="GITHUB  ★" Foreground="#E7B74E" BorderBrush="#756A3A" Padding="12,8" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CHỌN NGUỒN TELEMETRY" Foreground="#6F9188" FontFamily="Bahnschrift SemiCondensed" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="COOKIE CHỈ ĐỌC ĐÚNG HOST" Foreground="#4F746C" FontFamily="Bahnschrift" FontSize="8" />
                    </Grid>

                    <Button x:Name="EraSourceButton" Style="{StaticResource SourceButton}" Tag="era" Click="SourceButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="01" Foreground="#37D4C6" FontFamily="Bahnschrift" FontSize="10" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ERAGAMING" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="eragamingvn.net" Foreground="#66877F" FontSize="9" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="KẾT NỐI  →" Foreground="#7FB9AE" FontFamily="Bahnschrift SemiCondensed" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Button>

                    <Button x:Name="DinoSourceButton" Style="{StaticResource SourceButton}" Tag="dinovietnam" Click="SourceButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="02" Foreground="#37D4C6" FontFamily="Bahnschrift" FontSize="10" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DINOVIETNAM" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="dinovietnam.islepilot.eu" Foreground="#66877F" FontSize="9" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="KẾT NỐI  →" Foreground="#7FB9AE" FontFamily="Bahnschrift SemiCondensed" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Button>

                    <Button x:Name="PremiumSourceButton" Style="{StaticResource SourceButton}" Tag="dinovietnampremium" Click="SourceButton_Click" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="03" Foreground="#E7B74E" FontFamily="Bahnschrift" FontSize="10" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DINOVIETNAM PREMIUM" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="dinovietnampremium.islepilot.eu" Foreground="#8D835D" FontSize="9" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="KẾT NỐI  →" Foreground="#D2B95D" FontFamily="Bahnschrift SemiCondensed" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Button>

                    <TextBlock x:Name="SourceStatusLabel" Text="Chọn server. Nếu chưa có phiên, cửa sổ đăng nhập sẽ hướng dẫn bạn." Foreground="#6E8B84" FontSize="10" TextWrapping="Wrap" Margin="0,11,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#2F514B" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="#37D4C6" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdateStatusLabel" Grid.Column="1" Text="ĐANG KIỂM TRA CẬP NHẬT" Foreground="#64827A" FontFamily="Bahnschrift SemiCondensed" FontSize="8" VerticalAlignment="Center" Margin="7,0,0,0" />
                    <Button x:Name="ApplyUpdateButton" Grid.Column="2" Style="{StaticResource HomeChromeButton}" Content="CẬP NHẬT &amp; KHỞI ĐỘNG LẠI" Padding="9,4" Visibility="Collapsed" Click="ApplyUpdateButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
