<Window x:Class="TheIsleOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Isle Live Map" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closed="Window_Closed" StateChanged="Window_StateChanged">
    <Window.Resources>
        <Style x:Key="EditCommandButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Foreground" Value="#E9F4EE" />
            <Setter Property="Background" Value="#E31A3430" />
            <Setter Property="BorderBrush" Value="#6C5E8C82" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EditCommandChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditCommandChrome" Property="BorderBrush" Value="#D7E8F5EF" />
                                <Setter TargetName="EditCommandChrome" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#6EE2C9" BlurRadius="10" ShadowDepth="0" Opacity="0.34" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EditCommandChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditCommandChrome" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="EditCommandChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EditCommandChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditUtilityButton" TargetType="Button" BasedOn="{StaticResource EditCommandButton}">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="#E50D2220" />
            <Setter Property="BorderBrush" Value="#5A617A73" />
        </Style>
        <Style x:Key="WidgetResizeThumb" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="AutomationProperties.Name" Value="Kéo để đổi kích thước riêng block" />
            <Setter Property="ToolTip" Value="Kéo để đổi kích thước riêng block này" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="WidgetGripChrome" Background="#ED0A211E"
                                BorderBrush="#8A70B9AA" BorderThickness="1" CornerRadius="2">
                            <TextBlock Text="↘" Foreground="#8FE3D0" FontFamily="Bahnschrift"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,3,1"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WidgetGripChrome" Property="Background" Value="#F016403A" />
                                <Setter TargetName="WidgetGripChrome" Property="BorderBrush" Value="#B78FE3D0" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="WidgetGripChrome" Property="Background" Value="#F0275D54" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="OverlayScaleRoot">
        <Canvas x:Name="WidgetCanvas">

        <Border x:Name="MapPanel" Width="304" Height="304" Tag="Map"
                Canvas.Left="0" Canvas.Top="0"
                PreviewMouseLeftButtonDown="WidgetPanel_MouseLeftButtonDown"
                PreviewMouseMove="WidgetPanel_MouseMove"
                PreviewMouseLeftButtonUp="WidgetPanel_MouseLeftButtonUp"
                Background="#0C2020" BorderBrush="#783E625B" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Ellipse x:Name="MapCircleChrome" Fill="#0C2020" Stroke="#783E625B"
                         StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
                <Grid x:Name="MapVisualRoot">
                <Canvas x:Name="MapViewport" Background="#102423" SizeChanged="MapViewport_SizeChanged" ClipToBounds="True"
                        AutomationProperties.Name="Minimap Gateway viewport">
                    <Image x:Name="MapImage" Stretch="Fill" Opacity="0.93"
                           RenderOptions.BitmapScalingMode="Linear"
                           SnapsToDevicePixels="True" />
                    <Rectangle x:Name="MapShade" Fill="#0D00BBAA" IsHitTestVisible="False" />
                    <Canvas x:Name="MapHeatmapLayer" Panel.ZIndex="1" IsHitTestVisible="False" />
                    <Canvas x:Name="MapZoneLayer" Panel.ZIndex="2" IsHitTestVisible="False" />
                    <Canvas x:Name="MapFoodLayer" Panel.ZIndex="3" IsHitTestVisible="False" />
                    <Canvas x:Name="MapNoteLineLayer" Panel.ZIndex="4" IsHitTestVisible="False" />
                    <Canvas x:Name="MapNoteMarkerLayer" Panel.ZIndex="5" IsHitTestVisible="False" />
                    <Canvas x:Name="TeamMarkerLayer" Panel.ZIndex="6" IsHitTestVisible="False" />
                    <Canvas x:Name="RemotePlayerMarkerLayer" Panel.ZIndex="7" IsHitTestVisible="False" />
                    <Grid x:Name="PlayerMarker" Panel.ZIndex="8" Width="38" Height="38" IsHitTestVisible="False">
                        <Ellipse Width="31" Height="31" Stroke="#B037D4C6" StrokeThickness="1" />
                        <Ellipse Width="18" Height="18" Fill="#2B071719" Stroke="#ECF5F2" StrokeThickness="1" />
                        <Grid x:Name="DirectionNeedle" Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="PlayerHeadingTransform" Angle="0" />
                            </Grid.RenderTransform>
                            <Path Data="M 19,1 L 25,22 L 19,18 L 13,22 Z" Fill="#F4FFFB" Stroke="#37D4C6" StrokeThickness="0.7" />
                            <Line X1="19" Y1="20" X2="19" Y2="34" Stroke="#A337D4C6" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </Canvas>

                <Border x:Name="MapInfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10" MinWidth="170" MaxWidth="300" Background="Transparent"
                        BorderThickness="0" Padding="0">
                    <StackPanel>
                        <Grid Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PLAYER / AI" Foreground="#DCE8E0"
                                           FontFamily="Bahnschrift SemiCondensed" FontSize="9.5"
                                           FontWeight="SemiBold" />
                                <Ellipse Width="4" Height="4" Fill="#37D4C6"
                                         Margin="6,0,4,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="RemotePlayerCountLabel" Grid.Column="2"
                                       Text="P 0 · AI 0" Visibility="Collapsed"
                                       Foreground="#C9DDD6" FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="8" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="CoordinateLabel" Text="X —  Y —  Z —" Visibility="Collapsed"
                                   Foreground="#82A49B" FontFamily="Bahnschrift" FontSize="8.2"
                                   Margin="0,1,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MapLayerSummaryLabel" Text=""
                                       Visibility="Collapsed"
                                       Foreground="#76968D" FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="6.8" VerticalAlignment="Center" />
                            <StackPanel x:Name="RemoteEntityLegend" Grid.Column="1"
                                        Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="Collapsed" Margin="9,0,0,0">
                                <TextBlock Text="● THỊT" Foreground="#F04444" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" Margin="0,0,7,0" />
                                <TextBlock Text="● CÙNG" Foreground="#42D66B" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" Margin="0,0,7,0" />
                                <TextBlock Text="● CỎ" Foreground="#3EA6FF" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" Margin="0,0,7,0" />
                                <TextBlock Text="● AI" Foreground="#F5C542" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" Margin="0,0,7,0" />
                                <TextBlock Text="● ?" Foreground="#C7D0D4" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="RemoteTrackingStatusLabel" Text="PRO · ĐANG KHỞI TẠO"
                                   Visibility="Collapsed" Foreground="#E7B74E"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="7.2"
                                   FontWeight="SemiBold" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="270" />
                        <TextBlock x:Name="RemoteTrackingDiagnosticsLabel"
                                   Visibility="Collapsed" Foreground="#B8C8C5"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="7"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   MaxWidth="270" />
                    </StackPanel>
                </Border>

                <Button x:Name="MapFocusModeButton" Style="{StaticResource ChromeButton}"
                        Content="FOLLOW · GPS" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="10,0,0,10" MinWidth="0" Padding="0" FontSize="12"
                        FontWeight="Bold" Background="Transparent" BorderBrush="Transparent"
                        Foreground="#72E4D8" Click="MapFocusModeButton_Click"
                        ToolTip="Map tự bám theo GPS. ALT + kéo chuột trái để quan sát tự do." />
                <!-- Kept as a non-visual target for telemetry code; heading is now represented by the compass. -->
                <TextBlock x:Name="HeadingModeLabel" Visibility="Collapsed" />
                <Grid x:Name="MapCompassLabel" Width="74" Height="74"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,8,8" IsHitTestVisible="False"
                      AutomationProperties.Name="La bàn bốn hướng">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="B" HorizontalAlignment="Center"
                               Foreground="#A82929" FontFamily="Bahnschrift" FontSize="18"
                               FontWeight="Bold" AutomationProperties.Name="Bắc" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="T" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#A82929" FontFamily="Bahnschrift"
                               FontSize="18" FontWeight="Bold" AutomationProperties.Name="Tây" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="•" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#A82929" FontFamily="Bahnschrift"
                               FontSize="14" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Đ" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#A82929" FontFamily="Bahnschrift"
                               FontSize="18" FontWeight="Bold" AutomationProperties.Name="Đông" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="N" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#A82929" FontFamily="Bahnschrift"
                               FontSize="18" FontWeight="Bold" AutomationProperties.Name="Nam" />
                </Grid>
                <TextBlock x:Name="MapStateLabel" Text="ĐANG TẢI BẢN ĐỒ" Foreground="#A5BDB5" Background="#C0091718" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                </Grid>

                <!-- Layer switches live in the Edit Mode inspector. Keeping this
                     small surface free of toggles prevents accidental clicks on
                     the map and keeps Free/Pro rendering identical. -->
                <StackPanel x:Name="MapLayerControls" Visibility="Collapsed" />

                <StackPanel x:Name="MapZoomControls" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,40,8">
                    <Button Style="{StaticResource ChromeButton}" Content="+" Width="27" Height="25" Padding="0" Click="ZoomInButton_Click" />
                    <Button Style="{StaticResource ChromeButton}" Content="−" Width="27" Height="25" Padding="0" Margin="0,4,0,0" Click="ZoomOutButton_Click" />
                </StackPanel>

                <primitives:Thumb x:Name="MapResizeGrip" Tag="map" Panel.ZIndex="60"
                                  Style="{StaticResource WidgetResizeThumb}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7"
                                  DragStarted="WidgetResizeGrip_DragStarted"
                                  DragDelta="WidgetResizeGrip_DragDelta"
                                  DragCompleted="WidgetResizeGrip_DragCompleted" />
            </Grid>
        </Border>

        <Border x:Name="StatsPanel" Width="304" Height="170" Tag="Stats"
                Canvas.Left="0" Canvas.Top="312"
                PreviewMouseLeftButtonDown="WidgetPanel_MouseLeftButtonDown"
                PreviewMouseMove="WidgetPanel_MouseMove"
                PreviewMouseLeftButtonUp="WidgetPanel_MouseLeftButtonUp"
                BorderBrush="#5A3E625B" BorderThickness="1" CornerRadius="4" Padding="11,9,11,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#A3071517" Offset="0" />
                    <GradientStop Color="#76071517" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SpeciesLabel" Text="NO ACTIVE DINOSAUR" Foreground="{StaticResource FogBrush}" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock x:Name="PlayerNameLabel" Text="Awaiting telemetry" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="GROWTH" Foreground="{StaticResource MutedBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="8" HorizontalAlignment="Right" />
                        <TextBlock x:Name="GrowthLabel" Text="—" Foreground="#E7B74E" FontFamily="Bahnschrift" FontSize="15" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#425D57" Margin="0,8,0,0" />

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <TextBlock Text="HEALTH" Foreground="#D6E4DE" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        <ProgressBar x:Name="HealthBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Foreground="#EF6461" VerticalAlignment="Center" />
                        <TextBlock x:Name="HealthValue" Grid.Column="2" Text="— / —" Foreground="#AFC3BC" FontFamily="Bahnschrift" FontSize="9" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <TextBlock Text="STAMINA" Foreground="#D6E4DE" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        <ProgressBar x:Name="StaminaBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Foreground="#37D4C6" VerticalAlignment="Center" />
                        <TextBlock x:Name="StaminaValue" Grid.Column="2" Text="— / —" Foreground="#AFC3BC" FontFamily="Bahnschrift" FontSize="9" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <TextBlock Text="HUNGER" Foreground="#D6E4DE" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        <ProgressBar x:Name="HungerBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Foreground="#D8874D" VerticalAlignment="Center" />
                        <TextBlock x:Name="HungerValue" Grid.Column="2" Text="— / —" Foreground="#AFC3BC" FontFamily="Bahnschrift" FontSize="9" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <TextBlock Text="WATER" Foreground="#D6E4DE" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        <ProgressBar x:Name="WaterBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Foreground="#4B9BD4" VerticalAlignment="Center" />
                        <TextBlock x:Name="WaterValue" Grid.Column="2" Text="— / —" Foreground="#AFC3BC" FontFamily="Bahnschrift" FontSize="9" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="ConnectionDot" Width="5" Height="5" Fill="#E7B74E" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConnectionLabel" Grid.Column="1" Text="ĐANG KHỞI TẠO" Foreground="#64827A" FontFamily="Bahnschrift SemiCondensed" FontSize="8" Margin="6,0,0,0" />
                    <TextBlock x:Name="UpdatedLabel" Grid.Column="2" Text="—" Foreground="#64827A" FontFamily="Bahnschrift" FontSize="8" />
                </Grid>
                <Border x:Name="StatsMoveBadge" Panel.ZIndex="20" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0"
                        Background="#E10D2925" BorderBrush="#647F766E" BorderThickness="1"
                        CornerRadius="2" Padding="8,3" Cursor="SizeAll">
                    <TextBlock Text="STATUS · MOVE" Foreground="#C9DBD5"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="8" />
                </Border>
                <primitives:Thumb x:Name="StatsResizeGrip" Tag="stats" Panel.ZIndex="60"
                                  Style="{StaticResource WidgetResizeThumb}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-5"
                                  DragStarted="WidgetResizeGrip_DragStarted"
                                  DragDelta="WidgetResizeGrip_DragDelta"
                                  DragCompleted="WidgetResizeGrip_DragCompleted" />
            </Grid>
        </Border>

        <Border x:Name="TeamPanel" Width="304" Tag="Team"
                Canvas.Left="0" Canvas.Top="490" Visibility="Collapsed"
                PreviewMouseLeftButtonDown="WidgetPanel_MouseLeftButtonDown"
                PreviewMouseMove="WidgetPanel_MouseMove"
                PreviewMouseLeftButtonUp="WidgetPanel_MouseLeftButtonUp"
                BorderBrush="#5A3E625B" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Background="#A8071717">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="TeamConnectionDot" Width="5" Height="5" Fill="#37D4C6"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="TeamCodeLabel" Text="TEAM // ——————" Foreground="#DDEBE5"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="TeamConnectionLabel" Grid.Column="1" Text="RELAY"
                               Foreground="#67877F" FontFamily="Bahnschrift SemiCondensed" FontSize="8"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock x:Name="TeamCountLabel" Grid.Column="2" Text="1 NGƯỜI"
                               Foreground="#8EA79F" FontFamily="Bahnschrift" FontSize="8" />
                </Grid>

                <Rectangle Grid.Row="1" Fill="#405D56" Margin="0,7,0,0" />

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock x:Name="TeamEmptyLabel" Text="GỬI MÃ MỜI · ĐANG CHỜ ĐỒNG ĐỘI"
                               Foreground="#6F8C84" FontFamily="Bahnschrift SemiCondensed" FontSize="8.5"
                               HorizontalAlignment="Center" Margin="0,3" />
                    <ItemsControl x:Name="TeamMembersList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#620D2421" BorderBrush="#303F5E57" BorderThickness="0,0,0,1"
                                        Padding="3,4" Opacity="{Binding Opacity}">
                                    <Grid Height="29">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="94" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{Binding AccentBrush}" RadiusX="1" RadiusY="1" Margin="0,1" />
                                            <StackPanel Grid.Column="1" Margin="6,-1,2,0">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#E0ECE7"
                                                           FontFamily="Bahnschrift SemiCondensed" FontSize="10.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailText}" Foreground="{Binding DetailBrush}"
                                                           FontFamily="Bahnschrift" FontSize="7.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="HP" Foreground="#A67A78" FontFamily="Bahnschrift SemiCondensed" FontSize="7.5" />
                                            <TextBlock Text="{Binding HealthText}" Foreground="#EF7772" FontFamily="Bahnschrift" FontSize="10" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="ĐÓI" Foreground="#98775E" FontFamily="Bahnschrift SemiCondensed" FontSize="7.5" />
                                            <TextBlock Text="{Binding HungerText}" Foreground="#D99A68" FontFamily="Bahnschrift" FontSize="10" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="NƯỚC" Foreground="#6689A0" FontFamily="Bahnschrift SemiCondensed" FontSize="7.5" />
                                            <TextBlock Text="{Binding ThirstText}" Foreground="#68B4E8" FontFamily="Bahnschrift" FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Border x:Name="TeamMoveBadge" Panel.ZIndex="20" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0"
                        Background="#E10D2925" BorderBrush="#647F766E" BorderThickness="1"
                        CornerRadius="2" Padding="8,3" Cursor="SizeAll">
                    <TextBlock Text="TEAM · MOVE" Foreground="#C9DBD5"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="8" />
                </Border>
                <primitives:Thumb x:Name="TeamResizeGrip" Tag="team" Panel.ZIndex="60"
                                  Style="{StaticResource WidgetResizeThumb}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-4"
                                  DragStarted="WidgetResizeGrip_DragStarted"
                                  DragDelta="WidgetResizeGrip_DragDelta"
                                  DragCompleted="WidgetResizeGrip_DragCompleted" />
            </Grid>
        </Border>

        <Border x:Name="MissionPanel" Width="304" Tag="Prime"
                Canvas.Left="0" Canvas.Top="610" Visibility="Collapsed"
                PreviewMouseLeftButtonDown="WidgetPanel_MouseLeftButtonDown"
                PreviewMouseMove="WidgetPanel_MouseMove"
                PreviewMouseLeftButtonUp="WidgetPanel_MouseLeftButtonUp"
                BorderBrush="#665A5131" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Background="#B50B1715">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="#E7B74E" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="NHIỆM VỤ PRIME · ISLEPILOT" Foreground="#E9F4EE"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="MissionProgressLabel" Grid.Column="2" Text="0 / 0"
                               Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="SemiBold" />
                </Grid>
                <Rectangle Grid.Row="1" Fill="#5A51442B" Margin="0,7,0,0" />
                <ItemsControl x:Name="MissionList" Grid.Row="2" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}"
                                           FontFamily="Bahnschrift" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding TextBrush}"
                                           FontFamily="Segoe UI" FontSize="9" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="MissionMoveBadge" Panel.ZIndex="20" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0"
                        Background="#E10D2925" BorderBrush="#647F766E" BorderThickness="1"
                        CornerRadius="2" Padding="8,3" Cursor="SizeAll">
                    <TextBlock Text="PRIME · MOVE" Foreground="#C9DBD5"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="8" />
                </Border>
                <primitives:Thumb x:Name="MissionResizeGrip" Tag="prime" Panel.ZIndex="60"
                                  Style="{StaticResource WidgetResizeThumb}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-4"
                                  DragStarted="WidgetResizeGrip_DragStarted"
                                  DragDelta="WidgetResizeGrip_DragDelta"
                                  DragCompleted="WidgetResizeGrip_DragCompleted" />
            </Grid>
        </Border>

        <Border x:Name="LayoutControls" Width="304" Canvas.Left="0" Canvas.Top="790"
                Padding="9,7"
                Background="#E10A1F1D" BorderBrush="#6A52776F" BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LAYOUT SETTINGS" Foreground="#789A92"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="8" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="HUD SCALE // " Foreground="#BCD0C9"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="9" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverlayScaleLabel" Text="100%" Foreground="#E7B74E"
                                   FontFamily="Bahnschrift" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="ScaleDownButton" Grid.Column="1"
                        Style="{StaticResource ChromeButton}" Content="−"
                        Width="25" Height="27" Padding="0" FontSize="12"
                        AutomationProperties.Name="Thu nhỏ toàn bộ overlay"
                        ToolTip="Thu nhỏ toàn bộ overlay 10%"
                        Click="ScaleDownButton_Click" />
                <Button x:Name="ScaleResetButton" Grid.Column="3"
                        Style="{StaticResource ChromeButton}" Content="RESET"
                        Height="27" Padding="8,0"
                        AutomationProperties.Name="Đặt kích thước overlay về 100 phần trăm"
                        ToolTip="Đưa overlay về kích thước chuẩn 100%"
                        Click="ScaleResetButton_Click" />
                <Button x:Name="ScaleUpButton" Grid.Column="5"
                        Style="{StaticResource ChromeButton}" Content="+"
                        Width="25" Height="27" Padding="0" FontSize="12"
                        AutomationProperties.Name="Phóng to toàn bộ overlay"
                        ToolTip="Phóng to toàn bộ overlay 10%"
                        Click="ScaleUpButton_Click" />

                <primitives:Thumb x:Name="ResizeGrip" Grid.Column="7"
                                  Width="43" Height="29" Cursor="SizeNWSE"
                                  AutomationProperties.Name="Kéo để thay đổi kích thước toàn bộ overlay"
                                  ToolTip="Giữ và kéo để resize toàn bộ overlay"
                                  DragStarted="ResizeGrip_DragStarted"
                                  DragDelta="ResizeGrip_DragDelta"
                                  DragCompleted="ResizeGrip_DragCompleted">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                            <Border x:Name="GripChrome" CornerRadius="2"
                                    Background="#D5153732" BorderBrush="#64958B" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="DRAG" Foreground="#A8C8BF"
                                               FontFamily="Bahnschrift SemiCondensed" FontSize="7.5"
                                               Margin="6,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    <TextBlock Text="↘" Foreground="#37D4C6" FontSize="15"
                                               Margin="0,0,4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripChrome" Property="Background" Value="#E21B4942" />
                                    <Setter TargetName="GripChrome" Property="BorderBrush" Value="#79C5B8" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="GripChrome" Property="Background" Value="#F0275D54" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </Grid>
            <Grid Margin="0,7,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BLOCK HIỂN THỊ" Foreground="#789A92"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="8" />
                    <TextBlock Grid.Column="1" Text="LƯU TỰ ĐỘNG" Foreground="#58766E"
                               FontFamily="Bahnschrift" FontSize="7.5" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <ToggleButton x:Name="MapVisibilityToggle" Tag="map"
                                  Style="{StaticResource MapLayerToggle}" Content="MAP"
                                  IsChecked="True" Click="WidgetVisibilityToggle_Click"
                                  AutomationProperties.Name="Bật hoặc tắt block Map" />
                    <ToggleButton x:Name="StatsVisibilityToggle" Tag="stats"
                                  Style="{StaticResource MapLayerToggle}" Content="STATUS"
                                  IsChecked="True" Margin="3,0,0,0"
                                  Click="WidgetVisibilityToggle_Click"
                                  AutomationProperties.Name="Bật hoặc tắt block Status" />
                    <ToggleButton x:Name="TeamVisibilityToggle" Tag="team"
                                  Style="{StaticResource MapLayerToggle}" Content="TEAM"
                                  IsChecked="True" Margin="3,0,0,0"
                                  Click="WidgetVisibilityToggle_Click"
                                  AutomationProperties.Name="Bật hoặc tắt block Team" />
                    <ToggleButton x:Name="PrimeVisibilityToggle" Tag="prime"
                                  Style="{StaticResource MapLayerToggle}" Content="PRIME"
                                  IsChecked="True" Margin="3,0,0,0"
                                  Click="WidgetVisibilityToggle_Click"
                                  AutomationProperties.Name="Bật hoặc tắt block Prime" />
                    <Button x:Name="ShowAllWidgetsButton"
                            Style="{StaticResource ChromeButton}" Content="HIỆN TẤT CẢ"
                            Height="24" Padding="6,0" Margin="6,0,0,0" FontSize="7.5"
                            Foreground="#8FE3D0" BorderBrush="#4E746B"
                            AutomationProperties.Name="Hiện lại tất cả block overlay"
                            Click="ShowAllWidgetsButton_Click" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MAP SHAPE" Foreground="#789A92"
                           FontFamily="Bahnschrift SemiCondensed" FontSize="8"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="MapShapeButton" Grid.Column="1"
                        Style="{StaticResource ChromeButton}" Content="MAP · VUÔNG"
                        Height="26" MinWidth="92" Padding="9,0"
                        AutomationProperties.Name="Đổi minimap giữa hình vuông và hình tròn"
                        ToolTip="Chuyển minimap giữa hình vuông và hình tròn"
                        Click="MapShapeButton_Click" />
                <TextBlock Grid.Column="2" Text="Kéo ↘ để resize riêng"
                           Foreground="#789A92" FontFamily="Bahnschrift SemiCondensed"
                           FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Button x:Name="ResetWidgetLayoutButton" Style="{StaticResource ChromeButton}"
                    Content="ĐẶT LẠI VỊ TRÍ &amp; KÍCH THƯỚC BLOCK" Height="26" Margin="0,7,0,0"
                    Foreground="#E7B74E" BorderBrush="#665A5131"
                    AutomationProperties.Name="Đặt lại vị trí các block overlay"
                    Click="ResetWidgetLayoutButton_Click" />
            </StackPanel>
        </Border>
        </Canvas>

        <!-- Kept outside MapPanel so hiding Map never removes the recovery controls. -->
        <Border x:Name="EditToolbar" Panel.ZIndex="90"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0" Padding="6"
                Background="#F00A1816" BorderBrush="#78627770"
                BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Border Background="#E7132D29" BorderBrush="#607E756E"
                        BorderThickness="1" CornerRadius="4" Padding="10,0"
                        Height="42" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EDIT MODE" Foreground="#A8EEE0"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="ACTIVE" Foreground="#5EA99B"
                                   FontFamily="Bahnschrift" FontSize="7.5"
                                   HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
                <Button x:Name="EditHomeButton" Style="{StaticResource EditCommandButton}"
                        MinWidth="94" Margin="6,0,0,0"
                        Background="#E31B3442" BorderBrush="#7281A6B7"
                        Foreground="#E8F7FF" Click="HomeButton_Click"
                        ToolTip="Về Home và đổi nguồn telemetry"
                        AutomationProperties.Name="Mở Home">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons"
                                   FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="HOME" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditShortcutsButton" Style="{StaticResource EditCommandButton}"
                        MinWidth="92" Margin="5,0,0,0"
                        Background="#E3163A38" BorderBrush="#6B5EAAA1"
                        Foreground="#E4FFF8" Click="ShortcutSettingsButton_Click"
                        ToolTip="Cài đặt phím tắt và xử lý phím bị trùng"
                        AutomationProperties.Name="Mở cài đặt phím tắt">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons"
                                   FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="PHÍM" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenMapNotesFallbackButton" Style="{StaticResource EditCommandButton}"
                        MinWidth="92" Margin="5,0,0,0"
                        Background="#E33B3013" BorderBrush="#A18D7132"
                        Foreground="#FFF0A8" Click="OpenMapNotesFallbackButton_Click"
                        ToolTip="Mở bản đồ mốc Pro khi Alt+M bị ứng dụng khác chiếm"
                        AutomationProperties.Name="Mở bản đồ mốc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons"
                                   FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="MỐC" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="MapLayersButton" Style="{StaticResource EditCommandButton}"
                        MinWidth="142" Margin="5,0,0,0"
                        Background="#E31A3827" BorderBrush="#6D4F9268"
                        Foreground="#DDF8E5" Click="MapLayersButton_Click"
                        ToolTip="Bật/tắt zone, đường, nước và tài nguyên offline"
                        AutomationProperties.Name="Mở lớp bản đồ">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons"
                                   FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="LỚP BẢN ĐỒ" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="30" Background="#526E665F" Margin="7,6,2,6" />
                <Button x:Name="LockButton" Style="{StaticResource EditUtilityButton}"
                        MinWidth="78" Margin="5,0,0,0" Click="LockButton_Click"
                        ToolTip="Thoát Edit Mode và bật xuyên chuột"
                        AutomationProperties.Name="Khóa overlay">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="LockButtonLabel" Text="KHÓA"
                                   FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource EditUtilityButton}" Margin="5,0,0,0"
                        Width="42" Padding="0" Click="MinimizeButton_Click"
                        ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ overlay">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                </Button>
                <Button Style="{StaticResource EditUtilityButton}" Margin="5,0,0,0"
                        Width="42" Padding="0" Background="#E3381C1C" BorderBrush="#7E9B4E4E"
                        Foreground="#FFD7D7" Click="CloseButton_Click"
                        ToolTip="Đóng" AutomationProperties.Name="Đóng overlay">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="MapLayerInspector" Panel.ZIndex="95" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,12,0"
                Width="390" MaxHeight="820" Background="#F20B1B1A"
                BorderBrush="#6E7F766E" BorderThickness="1" CornerRadius="6" Padding="18,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="LỚP BẢN ĐỒ OFFLINE" Foreground="#F3DE8D"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" />
                        <Button HorizontalAlignment="Right" Content="×" Width="34" Height="32"
                                Style="{StaticResource ChromeButton}" Click="CloseMapLayerInspectorButton_Click" />
                    </Grid>
                    <TextBlock Text="Nguồn snapshot: myislemap.com · không cần mạng khi chạy"
                               Foreground="#789A92" FontFamily="Bahnschrift" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,14" />
                    <TextBlock Text="KHU VỰC &amp; ĐI LẠI" Foreground="#8FE3D0"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="Bold" Margin="0,4,0,6" />
                    <ToggleButton x:Name="MigrationLayerToggle" Tag="Migration" Content="◈  VÙNG DI CƯ"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="PatrolLayerToggle" Tag="Patrol" Content="◌  VÙNG TUẦN TRA"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="SanctuaryLayerToggle" Tag="Sanctuary" Content="⌂  KHU AN TOÀN"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="AiSpawnLayerToggle" Tag="AiSpawnZones" Content="✦  VÙNG AI"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="RoadLayerToggle" Tag="Roads" Content="╱  ĐƯỜNG &amp; LỐI MÒN"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="WaterLayerToggle" Tag="Water" Content="≈  NƯỚC UỐNG ĐƯỢC"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <TextBlock Text="THỨC ĂN &amp; TÀI NGUYÊN" Foreground="#8FE3D0"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="Bold" Margin="0,16,0,6" />
                    <ToggleButton x:Name="AnimalsLayerToggle" Tag="Animals" Content="●  ĐỘNG VẬT"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="PlantsLayerToggle" Tag="Plants" Content="❧  THỰC VẬT &amp; NẤM"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <ToggleButton x:Name="EarthLayerToggle" Tag="Earth" Content="◆  ĐẤT &amp; KHOÁNG"
                                  Style="{StaticResource MapLayerToggle}" Click="MapLayerToggle_Click" />
                    <TextBlock Text="LỌC TỪNG LOẠI" Foreground="#789A92"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" Margin="0,14,0,4" />
                    <StackPanel x:Name="ResourceLayerChildrenPanel" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="MissionToast" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,18,12,0"
                Background="#F00B201D" BorderBrush="#B0E7B74E" BorderThickness="1"
                CornerRadius="4" Padding="11,8" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MissionToastTransform" Y="-8" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#E7B74E" RadiusX="1" RadiusY="1" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="NHIỆM VỤ HOÀN THÀNH" Foreground="#FFE18A"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="9" FontWeight="SemiBold" />
                    <TextBlock x:Name="MissionToastLabel" Text="—" Foreground="#F0F7F3"
                               FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
