<Window x:Class="TheIsleOverlay.App.ProPromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt Isle Live Map Pro"
        Width="920" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F3F2E8" />
        <SolidColorBrush x:Key="Muted" Color="#9CAC9F" />
        <SolidColorBrush x:Key="Gold" Color="#F1C75B" />
        <SolidColorBrush x:Key="Mint" Color="#76D7C4" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#171204" />
            <Setter Property="Background" Value="#F1C75B" />
            <Setter Property="BorderBrush" Value="#FFE69A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFE184" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D5A93E" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9CAC9F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F3F2E8" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#233A35" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FC071411" BorderBrush="#6D5D716A" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border BorderBrush="#315049" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#F1C75B" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#76D7C4" /></Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD INTELLIGENCE // PRO" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="   STEAMID64 ACCESS" Foreground="#718A83" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" Padding="0" FontSize="16" AutomationProperties.Name="Đóng thông báo Pro" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="PromotionContent" Grid.Row="1" Margin="25,24,25,25" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="PromotionEntranceTransform" Y="10" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="430" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Margin="0,0,24,0" Background="#0A201D" BorderBrush="#557169" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                        <Image Source="Assets/ProMapPreview.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Minimap Pro hiển thị player và AI" />
                        <Rectangle Fill="#24000000" IsHitTestVisible="False" />
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#E0081B19" BorderBrush="#526F68" BorderThickness="0,0,1,1" Padding="10,7">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#76D7C4" Margin="0,0,7,0" /><TextBlock Text="LIVE SIGNAL · ALL SERVERS" Foreground="#EAF6F1" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border VerticalAlignment="Bottom" Background="#E6071411" BorderBrush="#66592D" BorderThickness="0,1,0,0" Padding="15,13">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="DỮ LIỆU TRONG TẦM NHÌN" Foreground="#F1C75B" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Player · AI · loài · cân nặng · zone" Foreground="#B7CAC4" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="REALTIME" Foreground="#76D7C4" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="1" Fill="#35554F" />

                <Grid Grid.Column="2" Margin="25,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="ISLE LIVE MAP PRO" Foreground="{StaticResource Mint}" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="CHỈ TỪ 28K" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="42" FontWeight="Bold" Margin="-2,1,0,0" />
                        <TextBlock Text="Thấy rõ hệ sinh thái đang chuyển động quanh bạn." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="Không phải hack: map chỉ hỗ trợ dữ liệu mục tiêu game đã gửi trong phạm vi render của bạn." Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,17,0,12" Background="#2A2310" BorderBrush="#75652F" BorderThickness="1" Padding="12,9">
                        <TextBlock Text="MỘT TÀI KHOẢN STEAM · KHÔNG GIỚI HẠN THIẾT BỊ" Foreground="#FFE7A0" FontFamily="Bahnschrift SemiCondensed" FontSize="10.5" FontWeight="Bold" TextAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Grid Height="53"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#FF4D57" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="PLAYER ĐƯỢC PHÂN LOẠI" Foreground="#F3F2E8" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Ăn thịt · cùng loài · ăn cỏ, kèm loài và cân nặng." Foreground="#879E97" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#263F3A" />
                        <Grid Height="53"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#F2BC3F" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="TÌM AI NHANH HƠN" Foreground="#F3F2E8" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="AI đã nhận diện hiển thị riêng để hỗ trợ quá trình nuôi." Foreground="#879E97" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#263F3A" />
                        <Grid Height="53"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#76D7C4" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="FULL TẤT CẢ SERVER" Foreground="#F3F2E8" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Không phụ thuộc website map hoặc plugin riêng của server." Foreground="#879E97" FontSize="10.5" /></StackPanel></Grid>
                        <Rectangle Height="1" Fill="#263F3A" />
                        <Grid Height="53"><Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Rectangle Fill="#6EA9FF" RadiusX="1" RadiusY="1" Margin="0,7" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="TACTICAL MAP" Foreground="#F3F2E8" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Zone, set point theo XYZ và chia sẻ mốc với đồng đội." Foreground="#879E97" FontSize="10.5" /></StackPanel></Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuietButton}" Content="ĐỂ SAU" Padding="6,10" Click="CloseButton_Click" AutomationProperties.Name="Đóng và xem sau" />
                        <TextBlock Grid.Column="1" Text="PRO THEO STEAMID64" Foreground="#6F8A83" FontFamily="Bahnschrift SemiCondensed" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button x:Name="ActivateProButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="KÍCH HOẠT PRO NGAY" Height="43" Padding="17,0" IsDefault="True" AutomationProperties.Name="Mở trang kích hoạt Pro" Click="ActivateProButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
