<Window x:Class="TheIsleOverlay.App.ProSteamLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Kích hoạt Isle Live Map Pro · chỉ từ 28K" Width="1060" Height="760"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#071716" Foreground="#E9F4EE"
        FontFamily="Segoe UI Variable Text"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Background="#0B201E" BorderBrush="#5D5936" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#E7B74E" RadiusX="1" RadiusY="1" Margin="0,13" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="KÍCH HOẠT STEAM / PRO ACCESS"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="18"
                               FontWeight="Bold" Foreground="#FFE5A0" />
                    <TextBlock Text="Một lần mua · dùng theo SteamID64 · không giới hạn thiết bị"
                               Foreground="#9B9A78" FontSize="10.5" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="CHỈ TỪ 28K" Foreground="#F1C75B"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="17"
                               FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="PRO ACCESS · STEAMID64"
                               Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" Margin="0,3,0,0"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12" Background="#0A1A19"
                BorderBrush="#465D4E" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="LoginBrowser" />
                <Border x:Name="BrowserLoadingPanel" Background="#F2071716">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="24" Height="24" Stroke="#E7B74E" StrokeThickness="2" />
                        <TextBlock Text="ĐANG MỞ XÁC MINH STEAM…"
                                   Foreground="#A29E7F" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="10" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0B201E" BorderBrush="#5D5936" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginStatusLabel"
                           Text="CHỈ TỪ 28K · SteamID64 và token mã hóa DPAPI được lưu; không tạo khóa theo thiết bị."
                           Foreground="#8F9E8A" FontSize="10.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="THỬ LẠI" Padding="15,7" Margin="10,0,0,0"
                        Click="RetryButton_Click" Background="#3B3820" Foreground="#FFF4C2"
                        BorderBrush="#7B7041" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
                <Button Grid.Column="2" Content="HỦY" Padding="15,7" Margin="8,0,0,0"
                        Click="CancelButton_Click" Background="Transparent" Foreground="#A8BBB5"
                        BorderBrush="#48655F" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
