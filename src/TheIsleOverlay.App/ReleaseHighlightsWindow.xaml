<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới trong Isle Live Map"
        Width="1000" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="#93A79F"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F2F4EC" />
        <SolidColorBrush x:Key="Muted" Color="#91A49D" />
        <SolidColorBrush x:Key="Mint" Color="#8FE3D0" />
        <SolidColorBrush x:Key="Gold" Color="#F1C75B" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#161304" />
            <Setter Property="Background" Value="#F1C75B" />
            <Setter Property="BorderBrush" Value="#FFE49A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFE184" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D6A83E" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#C9D6D1" />
            <Setter Property="Background" Value="#101F1B" />
            <Setter Property="BorderBrush" Value="#3C5B52" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#91A49D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FreeTag" TargetType="Border">
            <Setter Property="Background" Value="#152A24" />
            <Setter Property="BorderBrush" Value="#4B8173" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ProTag" TargetType="Border" BasedOn="{StaticResource FreeTag}">
            <Setter Property="Background" Value="#332B13" />
            <Setter Property="BorderBrush" Value="#8E793D" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="#36564E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0D211C" />
            <Setter Property="Padding" Value="17" />
        </Style>
        <Style x:Key="ProPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="BorderBrush" Value="#81703A" />
            <Setter Property="Background" Value="#241F0E" />
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FD071411" BorderBrush="#685D716B" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" BorderBrush="#315049" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#F1C75B" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#8FE3D0" /></Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD UPDATE // 05 BRIEFINGS" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP · v1.4.9" Foreground="#718A83" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" FontSize="16" AutomationProperties.Name="Đóng; lần sau vẫn hiện" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Background="#0B1B17" BorderBrush="#315049" BorderThickness="0,0,1,0">
                <Grid Margin="20,20,18,21">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="FIELD BRIEFING" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" />
                        <TextBlock Text="Đi hết 5 mục để xem đủ thay đổi." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepOneMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="1" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="EARLY TRACKING" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Pro · 1.4.7" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepTwoMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="2" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="STABLE MARKERS" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Recovery · ghost filter" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepThreeMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="3" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="CIRCLE MAP" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Free · 1.4.8" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFourMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="4" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="RESIZE BLOCKS" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="4 block độc lập" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="47"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFiveMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="5" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="ACCESS SUMMARY" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Free và Pro" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · CHO MỌI USER" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                        <Border Style="{StaticResource ProTag}" Margin="0,7,0,0"><TextBlock Text="PRO · CẦN PRO ACCESS" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Grid.Column="1" Margin="28,24,28,18" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="ReleaseEntranceTransform" Y="10" /></Grid.RenderTransform>

                <Grid x:Name="PageOne">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · v1.4.7" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="MAP BẮT ĐẦU NGHE TRƯỚC KHI BẠN MỞ." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Pro Agent khởi động ngay tại Home sau khi SteamID64 được xác minh." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,30,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ProPanel}" Padding="15"><StackPanel><TextBlock Text="01" Foreground="#F1C75B" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="XÁC MINH PRO" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="Kiểm tra access tại Home" Foreground="#B4AA86" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                        <TextBlock Grid.Column="1" Text="→" Foreground="#F1C75B" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource ProPanel}" Padding="15"><StackPanel><TextBlock Text="02" Foreground="#F1C75B" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="AGENT THEO DÕI" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="Thu nhận packet sớm" Foreground="#B4AA86" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                        <TextBlock Grid.Column="3" Text="→" Foreground="#F1C75B" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Style="{StaticResource ProPanel}" Padding="15"><StackPanel><TextBlock Text="03" Foreground="#F1C75B" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="MỞ MAP PRO" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="Có sẵn state đã bắt" Foreground="#B4AA86" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#66592D" BorderThickness="1" Background="#241F0E" Padding="17"><TextBlock Text="Giảm thời gian chờ và hạn chế bỏ lỡ creation packet trong lúc người dùng còn ở Home." Foreground="#D0C495" FontSize="10.5" TextWrapping="Wrap" /></Border>
                </Grid>

                <Grid x:Name="PageTwo" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · v1.4.7" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="MARKER BỀN HƠN QUA TỪNG BATCH." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Tracker ghép state theo thời gian thay vì chỉ chờ một packet hoàn chỉnh." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource ProPanel}"><StackPanel><TextBlock Text="ONGOING ACTOR" Foreground="#FFE18A" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Late-attach recovery dựng lại player từ các mảnh replication đang tiếp diễn." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource ProPanel}"><StackPanel><TextBlock Text="SPARSE BATCH" Foreground="#FFE18A" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Cache giữ marker khi batch mới chỉ chứa phần dữ liệu vừa thay đổi." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Row="2" Style="{StaticResource ProPanel}"><StackPanel><TextBlock Text="DESTROY EVENT" Foreground="#EF6461" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Marker được gỡ theo destroy hoặc endpoint reset, không giữ actor đã rời vùng." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ProPanel}"><StackPanel><TextBlock Text="GHOST FILTER" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" /><TextBlock Text="Chặn manager, replicated array, AI và local player bị dựng nhầm thành player khác." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Pro Agent 0.3.21 · tracking chỉ hoạt động khi tài khoản còn Pro access." Foreground="#7E918A" FontFamily="Bahnschrift" FontSize="9.5" Margin="0,15,0,0" />
                </Grid>

                <Grid x:Name="PageThree" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · v1.4.8" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="MAP · VUÔNG HAY MAP · TRÒN?" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="31" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Chọn hình dáng minimap hợp với HUD của bạn — hoàn toàn miễn phí." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="205" Height="205" BorderBrush="#8FE3D0" BorderThickness="2" Background="#102A24"><Grid><Polyline Points="20,165 58,120 93,139 132,72 186,45" Stroke="#3F7668" StrokeThickness="2" /><Ellipse Width="12" Height="12" Fill="#F1C75B" /><TextBlock Text="MAP · VUÔNG" Foreground="#F2F4EC" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" /></Grid></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Width="205" Height="205" CornerRadius="103" BorderBrush="#F1C75B" BorderThickness="2" Background="#102A24" ClipToBounds="True"><Grid><Polyline Points="20,165 58,120 93,139 132,72 186,45" Stroke="#3F7668" StrokeThickness="2" /><Ellipse Width="12" Height="12" Fill="#F1C75B" /><TextBlock Text="MAP · TRÒN" Foreground="#F2F4EC" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" /></Grid></Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14"><StackPanel Orientation="Horizontal"><TextBlock Text="CTRL + SHIFT + O" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" /><TextBlock Text="   →   Chọn MAP · VUÔNG / MAP · TRÒN. Lựa chọn được lưu tự động." Foreground="#A9BAB4" FontSize="10.5" /></StackPanel></Border>
                </Grid>

                <Grid x:Name="PageFour" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · v1.4.8" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="4 BLOCK. 4 KÍCH THƯỚC RIÊNG." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="31" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Sắp xếp overlay theo màn hình và cách chơi của chính bạn." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Background="#091A16">
                            <Border BorderBrush="#8FE3D0" BorderThickness="1" Margin="12,12,175,118"><Grid><TextBlock Text="MAP" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" Margin="10" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                            <Border BorderBrush="#526E65" BorderThickness="1" Margin="212,12,12,176"><Grid><TextBlock Text="STATUS" Foreground="#C8D4CF" FontFamily="Bahnschrift" FontSize="9" Margin="9" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                            <Border BorderBrush="#526E65" BorderThickness="1" Margin="212,108,12,82"><Grid><TextBlock Text="TEAM" Foreground="#C8D4CF" FontFamily="Bahnschrift" FontSize="9" Margin="9" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                            <Border BorderBrush="#526E65" BorderThickness="1" Margin="94,207,12,12"><Grid><TextBlock Text="PRIME" Foreground="#C8D4CF" FontFamily="Bahnschrift" FontSize="9" Margin="9" /><TextBlock Text="↘" Foreground="#F1C75B" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid></Border>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="CTRL + SHIFT + O" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="Vào chế độ chỉnh layout." Foreground="#91A49D" FontSize="10.5" Margin="0,5,0,18" />
                            <TextBlock Text="KÉO TAY NẮM ↘" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Resize riêng Map, Status, Team và Prime. HUD scale chung vẫn được giữ." Foreground="#91A49D" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,18" />
                            <TextBlock Text="TỰ ĐỘNG GHI NHỚ" Foreground="#F1C75B" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Vị trí và kích thước trở lại đúng layout ở lần mở sau." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Đặt lại layout sẽ khôi phục cả vị trí lẫn kích thước mặc định của từng block." Foreground="#718A83" FontSize="10" Margin="0,15,0,0" />
                </Grid>

                <Grid x:Name="PageFive" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="ACCESS SUMMARY · v1.4.9" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="MỘT MAP. HAI CẤP TRUY CẬP RÕ RÀNG." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="1.4.9 tổng hợp trọn vẹn những thay đổi đã đến trong 1.4.7 và 1.4.8." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="FREE" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" /><TextBlock Text="LAYOUT CỦA BẠN" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" Margin="0,9,0,12" /><TextBlock Text="✓  Map tròn hoặc vuông" Foreground="#C5D2CD" FontSize="11" Margin="0,0,0,8" /><TextBlock Text="✓  Di chuyển và resize từng block" Foreground="#C5D2CD" FontSize="11" Margin="0,0,0,8" /><TextBlock Text="✓  Lưu layout qua lần mở sau" Foreground="#C5D2CD" FontSize="11" /><TextBlock Text="CTRL + SHIFT + O" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" Margin="0,22,0,0" /></StackPanel></Border>
