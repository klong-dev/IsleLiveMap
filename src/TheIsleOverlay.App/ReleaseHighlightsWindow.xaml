<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới trong Isle Live Map" Width="1080" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text" FontSize="13" Foreground="#93A79F"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F2F4EC" />
        <SolidColorBrush x:Key="Muted" Color="#91A49D" />
        <SolidColorBrush x:Key="Gold" Color="#F1C75B" />
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#161304" /><Setter Property="Background" Value="#F1C75B" />
            <Setter Property="BorderBrush" Value="#FFE49A" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" /><Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" /><Setter Property="Padding" Value="18,0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFE184" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D6A83E" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="#C9D6D1" /><Setter Property="Background" Value="#101F1B" /><Setter Property="BorderBrush" Value="#3C5B52" /></Style>
        <Style x:Key="QuietButton" TargetType="Button"><Setter Property="Foreground" Value="#91A49D" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style x:Key="FreeTag" TargetType="Border"><Setter Property="Background" Value="#152A24" /><Setter Property="BorderBrush" Value="#4B8173" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="8,4" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
        <Style x:Key="ProTag" TargetType="Border" BasedOn="{StaticResource FreeTag}"><Setter Property="Background" Value="#332B13" /><Setter Property="BorderBrush" Value="#8E793D" /></Style>
        <Style x:Key="CaptureFrame" TargetType="Border"><Setter Property="Background" Value="#071411" /><Setter Property="BorderBrush" Value="#49675F" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="7" /><Setter Property="ClipToBounds" Value="True" /></Style>
        <Style x:Key="FeatureLine" TargetType="TextBlock"><Setter Property="Foreground" Value="#C5D2CD" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,9" /></Style>
    </Window.Resources>

    <Border Margin="14" Background="#FD071411" BorderBrush="#685D716B" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="215" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" BorderBrush="#315049" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#F1C75B" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#8FE3D0" /></Grid><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="FIELD UPDATE // 05 BRIEFINGS" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" /><TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP" Foreground="#718A83" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" /></StackPanel><Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" FontSize="16" Click="CloseButton_Click" /></Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Background="#0B1B17" BorderBrush="#315049" BorderThickness="0,0,1,0">
                <Grid Margin="20,20,18,21"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="MAP FIELD KIT" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" /><TextBlock Text="Ảnh từ chính giao diện mới." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0" /></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Grid Height="55"><Grid.ColumnDefinitions><ColumnDefinition Width="33" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepLayersMarker" Width="26" Height="26" BorderThickness="1" CornerRadius="13"><TextBlock Text="1" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="LỚP BẢN ĐỒ OFFLINE" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Zone · đường · nước · tài nguyên" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="55"><Grid.ColumnDefinitions><ColumnDefinition Width="33" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepNotesMarker" Width="26" Height="26" BorderThickness="1" CornerRadius="13"><TextBlock Text="2" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="ALT + M / MỐC" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Click · XYZ · 4 cách xóa" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="55"><Grid.ColumnDefinitions><ColumnDefinition Width="33" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepTeamMarker" Width="26" Height="26" BorderThickness="1" CornerRadius="13"><TextBlock Text="3" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="NHÓM SINH TỒN" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Snapshot · reconnect · TTL" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="55"><Grid.ColumnDefinitions><ColumnDefinition Width="33" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepHudMarker" Width="26" Height="26" BorderThickness="1" CornerRadius="13"><TextBlock Text="4" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="MINIMAP GỌN HƠN" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Chỉ giữ thông tin cần thiết" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="55"><Grid.ColumnDefinitions><ColumnDefinition Width="33" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepSummaryMarker" Width="26" Height="26" BorderThickness="1" CornerRadius="13"><TextBlock Text="5" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="FREE / PRO" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Quyền rõ ràng · tự ghi nhớ" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3"><Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · LAYER + TÙY CHỈNH" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border><Border Style="{StaticResource ProTag}" Margin="0,7,0,0"><TextBlock Text="PRO · MỐC + TRACKING" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border></StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Grid.Column="1" Margin="28,22,28,17" Opacity="0"><Grid.RenderTransform><TranslateTransform x:Name="ReleaseEntranceTransform" Y="10" /></Grid.RenderTransform>
                <Grid x:Name="PageLayers"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · HOẠT ĐỘNG OFFLINE" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="BẬT ĐÚNG THỨ BẠN CẦN TRÊN MAP." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="28" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="Ctrl + Shift + O → LỚP BẢN ĐỒ. Dữ liệu đã được đóng gói local và dùng được cả khi mất mạng." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,7,0,18" TextWrapping="Wrap" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  12 Migration · 61 Patrol · 7 Sanctuary" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  52 AI Spawn · 32 Roads &amp; Trails · 28 nguồn nước" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  430 Animal · 245 Plant/Fungi · 278 Earth points" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Lọc theo nhóm hoặc riêng từng loài/tài nguyên" /><Border Margin="0,9,0,0" Padding="12,9" Background="#10251F" BorderBrush="#41675D" BorderThickness="1" CornerRadius="3"><TextBlock Text="Lựa chọn được ghi nhớ. Minimap và Alt + M dùng chung bộ lọc." Foreground="#A9C8BE" FontSize="10.5" TextWrapping="Wrap" /></Border></StackPanel><Border Grid.Column="2" Style="{StaticResource CaptureFrame}"><Image Source="Assets/ReleaseHighlights/MapLayerInspector.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Border></Grid>

                <Grid x:Name="PageNotes" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions><StackPanel><Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · ALT + M" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="MỐC ỔN ĐỊNH, XÓA ĐƯỢC NGAY." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="Bold" Margin="0,9,0,0" /><TextBlock Text="Marker không còn bị dựng lại theo từng nhịp GPS nên click, selection và popup không bị mất." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Margin="18,2,0,0"><TextBlock Text="4 CÁCH XÓA" Foreground="#F1C75B" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /><TextBlock Text="Thùng rác · XÓA MỐC · Delete · Chuột phải" Foreground="#D5DCCF" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource CaptureFrame}" Margin="0,17,0,0"><Image Source="Assets/ReleaseHighlights/MapNotesAltM.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Border></Grid>

                <Grid x:Name="PageTeam" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · NHÓM SINH TỒN" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="ĐỒNG ĐỘI KHÔNG CÒN BIẾN MẤT VÌ MỘT DELTA BỊ LỠ." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="26" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="Snapshot khi connect, reconnect và định kỳ. Endpoint server được chuẩn hóa để nhận đúng đồng đội cùng server." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><Border Grid.Row="1" Style="{StaticResource CaptureFrame}" Margin="0,18,0,0" HorizontalAlignment="Left" Width="560"><Image Source="Assets/ReleaseHighlights/SurvivalTeamPanel.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Border><Grid Grid.Row="2" Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="10 GIÂY" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Text="Snapshot tự phục hồi delta bị bỏ lỡ." Foreground="#A9BAB4" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel><Rectangle Grid.Column="1" Fill="#38534D" /><StackPanel Grid.Column="2" Margin="18,0"><TextBlock Text="15 GIÂY" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Text="Giữ vị trí cuối và giảm opacity khi nối lại." Foreground="#A9BAB4" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel><Rectangle Grid.Column="3" Fill="#38534D" /><StackPanel Grid.Column="4" Margin="18,0,0,0"><TextBlock Text="35 GIÂY" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Text="Giữ dòng thành viên, báo MẤT TÍN HIỆU." Foreground="#A9BAB4" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Grid></Grid>

                <Grid x:Name="PageHud" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="365" /><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CaptureFrame}" VerticalAlignment="Center"><Image Source="Assets/ReleaseHighlights/CompactTrackingMap.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE + PRO · HUD MỚI" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="MINIMAP NHẸ MẮT, KHÔNG CHIẾM CHỖ." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="Đã bỏ GATEWAY / LIVE, tọa độ XYZ và dòng MMZ / PZ / FOOD khỏi góc trái." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,7,0,17" TextWrapping="Wrap" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Giữ số Player / AI và trạng thái đồng bộ" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Giữ legend Thịt · Cùng · Cỏ · AI · Chưa rõ" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Layer tĩnh không rebuild theo telemetry" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Heading, Follow GPS, zoom và ALT + kéo vẫn giữ nguyên" /></StackPanel></Grid>

                <Grid x:Name="PageSummary" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><Border Style="{StaticResource FreeTag}"><TextBlock Text="UPDATE SUMMARY" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="FREE LÀ NỀN TẢNG. PRO THÊM KHẢ NĂNG PHỐI HỢP." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel><Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#0D211C" BorderBrush="#36564E" BorderThickness="1" Padding="18" CornerRadius="4"><StackPanel><TextBlock Text="FREE" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Text="MAP + LAYER OFFLINE" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" Margin="0,8,0,13" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Zone, Road, Water và Resource" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  Parent/child switch và tự ghi nhớ" /><TextBlock Style="{StaticResource FeatureLine}" Text="✓  HUD gọn, tròn/vuông, resize từng block" /><TextBlock Text="CTRL + SHIFT + O" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" Margin="0,12,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="#241F0E" BorderBrush="#81703A" BorderThickness="1" Padding="18" CornerRadius="4"><StackPanel><TextBlock Text="PRO" Foreground="#F1C75B" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Text="TRACKING + TEAM + MỐC" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" Margin="0,8,0,13" /><TextBlock Style="{StaticResource FeatureLine}" Foreground="#E0D4A4" Text="✓  Player / AI tracking trong vùng render" /><TextBlock Style="{StaticResource FeatureLine}" Foreground="#E0D4A4" Text="✓  Alt + M, nhập XYZ và chia sẻ mốc" /><TextBlock Style="{StaticResource FeatureLine}" Foreground="#E0D4A4" Text="✓  Team snapshot / reconnect / chống dữ liệu cũ" /><TextBlock Text="ALT + M" Foreground="#F1C75B" FontFamily="Bahnschrift" FontSize="10" FontWeight="Bold" Margin="0,12,0,0" /></StackPanel></Border></Grid><CheckBox x:Name="DoNotShowAgainCheckBox" Grid.Row="2" Content="Không hiển thị lại thông báo cập nhật này" Foreground="#C6D2CD" FontSize="11" FontWeight="SemiBold" Margin="1,17,0,0" VerticalContentAlignment="Center" /></Grid>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1" Margin="28,0,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Content="←  QUAY LẠI" Width="104" Height="40" Visibility="Hidden" Click="BackButton_Click" /><TextBlock x:Name="PageProgressLabel" Grid.Column="1" Text="01 / 05" Foreground="#6E8780" FontFamily="Bahnschrift" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" /><Button x:Name="OpenProButton" Grid.Column="2" Style="{StaticResource QuietButton}" Content="XEM CÁC GÓI PRO" Height="40" Padding="12,0" Margin="0,0,10,0" Visibility="Collapsed" Click="ShowProButton_Click" /><Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="TIẾP THEO  →" Height="40" MinWidth="122" Click="NextButton_Click" /><Button x:Name="FinishButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="HOÀN TẤT" Height="40" MinWidth="122" Visibility="Collapsed" IsDefault="True" Click="FinishButton_Click" /></Grid>
        </Grid>
    </Border>
</Window>
