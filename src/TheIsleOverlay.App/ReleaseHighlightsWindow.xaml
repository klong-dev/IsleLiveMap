<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới trong Isle Live Map"
        Width="760" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="ReleaseBone" Color="#E9F4EE" />
        <SolidColorBrush x:Key="ReleaseMuted" Color="#9EB3AD" />
        <SolidColorBrush x:Key="ReleaseTeal" Color="#37D4C6" />
        <SolidColorBrush x:Key="ReleaseAmber" Color="#E7B74E" />

        <Style x:Key="ReleaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F1FFFB" />
            <Setter Property="Background" Value="#D41B4942" />
            <Setter Property="BorderBrush" Value="#5C9D91" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#285D54" />
                                <Setter Property="BorderBrush" Value="#76C5B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#347166" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FA071716" BorderBrush="#7258736C"
            BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="5" Opacity="0.8" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#31534D" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18">
                        <Ellipse Width="15" Height="15" Stroke="#E7B74E" StrokeThickness="1" />
                        <Ellipse Width="5" Height="5" Fill="#37D4C6" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="PATCH NOTES // DEPLOYED" Foreground="{StaticResource ReleaseBone}"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP · v1.2.0"
                                   Foreground="#7F9B94" FontFamily="Bahnschrift" FontSize="9.5"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource ReleaseButton}" Content="×"
                            Width="29" Height="25" Padding="0" FontSize="15"
                            AutomationProperties.Name="Đóng nội dung bản cập nhật" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Margin="28,23,28,24" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ReleaseEntranceTransform" Y="10" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BẢN CẬP NHẬT TÍNH NĂNG" Foreground="{StaticResource ReleaseTeal}"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="MAP BIẾT DẪN ĐƯỜNG."
                                   Foreground="{StaticResource ReleaseBone}" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="31" FontWeight="Bold" Margin="-1,2,0,0" />
                        <TextBlock Text="Nhiệm vụ rõ hơn, thao tác nhanh hơn và bản đồ ổn định trên nhiều máy hơn."
                                   Foreground="{StaticResource ReleaseMuted}" FontSize="12.5" FontWeight="Medium" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="VERSION" Foreground="#6F8C84" FontFamily="Bahnschrift SemiCondensed" FontSize="9" HorizontalAlignment="Right" />
                        <TextBlock x:Name="HeroVersionLabel" Text="1.2.0" Foreground="#FFE18A"
                                   FontFamily="Bahnschrift" FontSize="28" FontWeight="Bold" Margin="0,-3,0,0" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1" Fill="#35554F" />

                <Border Grid.Row="2" Margin="0,15,0,17" Background="#810A1D1B"
                        BorderBrush="#455F59" BorderThickness="1" CornerRadius="3" Padding="15,0">
                    <StackPanel>
                        <Grid Height="62">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="01" Foreground="#E7B74E" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="CHỈ ĐƯỜNG TỌA ĐỘ" Foreground="#FFE18A" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Dán X, Y, Z để vẽ đường và beacon tới đích" Foreground="{StaticResource ReleaseMuted}" FontSize="11.5" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Background="#C20A1D1B" BorderBrush="#756A3A" BorderThickness="1" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="CTRL + SHIFT + O" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Rectangle Height="1" Fill="#304A45" />
                        <Grid Height="62">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="02" Foreground="#E7B74E" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="NHIỆM VỤ PRIME" Foreground="#E4EEE9" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Tiếng Việt + thông báo khi hoàn thành" Foreground="{StaticResource ReleaseMuted}" FontSize="11.5" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Background="#C20A1D1B" BorderBrush="#526C65" BorderThickness="1" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="ALT + N" Foreground="#E9F4EE" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Rectangle Height="1" Fill="#304A45" />
                        <Grid Height="62">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="03" Foreground="#37D4C6" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="ẨN / HIỆN TOÀN BỘ HUD" Foreground="#90E6DA" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Dọn màn hình ngay mà không cần đóng tool" Foreground="{StaticResource ReleaseMuted}" FontSize="11.5" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Background="#C20A1D1B" BorderBrush="#4B8177" BorderThickness="1" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="ALT + P" Foreground="#90E6DA" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <Rectangle Height="1" Fill="#304A45" />
                        <Grid Height="62">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="04" Foreground="#7A9B93" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="MAP TƯƠNG THÍCH HƠN" Foreground="#E4EEE9" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Không còn phụ thuộc codec WebP của Windows" Foreground="{StaticResource ReleaseMuted}" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="FIX" Foreground="#7FA49B" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Height="1" Fill="#304A45" />
                        <Grid Height="62">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="05" Foreground="#7A9B93" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="MARKER SERVER ỔN ĐỊNH" Foreground="#E4EEE9" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Khôi phục vị trí khi API thiếu self hoặc calibration" Foreground="{StaticResource ReleaseMuted}" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="FIX" Foreground="#7FA49B" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="THÔNG BÁO PHIÊN BẢN" Foreground="{StaticResource ReleaseTeal}" FontFamily="Bahnschrift SemiCondensed" FontSize="9.5" FontWeight="SemiBold" />
                        <TextBlock Text="Bảng này chỉ xuất hiện một lần sau mỗi lần nâng cấp."
                                   Foreground="#819A93" FontSize="10.5" FontWeight="Medium" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="EnterToolButton" Grid.Column="1" Style="{StaticResource ReleaseButton}"
                            Content="ĐÃ XEM · BẮT ĐẦU  →" Height="43" Padding="19,0"
                            IsDefault="True" AutomationProperties.Name="Đóng nội dung cập nhật"
                            Click="CloseButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
