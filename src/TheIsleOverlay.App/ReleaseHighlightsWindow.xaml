<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Live Map Pro vừa ra mắt"
        Width="920" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="ReleaseBone" Color="#EDF5F0" />
        <SolidColorBrush x:Key="ReleaseMuted" Color="#9AAFA9" />
        <SolidColorBrush x:Key="ReleaseTeal" Color="#48D8C9" />

        <Style x:Key="ReleaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#071715" />
            <Setter Property="Background" Value="#F1C55B" />
            <Setter Property="BorderBrush" Value="#FFE69B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE08B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D6A83F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9CB0AA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EDF5F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#233A35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FC071513" BorderBrush="#6D5B756E"
            BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#31534D" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18">
                        <Ellipse Width="16" Height="16" Stroke="#F1C55B" StrokeThickness="1" />
                        <Ellipse Width="5" Height="5" Fill="#48D8C9" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD INTELLIGENCE // PRO" Foreground="{StaticResource ReleaseBone}"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP · v1.4.0"
                                   Foreground="#728E87" FontFamily="Bahnschrift" FontSize="9.5"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×"
                            Width="30" Height="26" Padding="0" FontSize="16"
                            AutomationProperties.Name="Đóng thông báo Isle Live Map Pro"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Margin="25,24,25,25" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ReleaseEntranceTransform" Y="12" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,24,0">
                    <Border Background="#0A201D" BorderBrush="#48665F" BorderThickness="1"
                            CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image Source="Assets/ProMapPreview.png" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="Minimap Pro hiển thị player và AI đã phân loại" />
                            <Rectangle Fill="#26000000" IsHitTestVisible="False" />
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Background="#D8081B19" BorderBrush="#526F68" BorderThickness="0,0,1,1"
                                    Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#48D8C9" Margin="0,0,7,0" />
                                    <TextBlock Text="LIVE SIGNAL · GATEWAY" Foreground="#EAF6F1"
                                               FontFamily="Bahnschrift SemiCondensed" FontSize="10"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Rectangle x:Name="RadarScanLine" Height="2" VerticalAlignment="Top"
                                       Fill="#B5DDFE91" Opacity="0">
                                <Rectangle.Effect>
                                    <BlurEffect Radius="4" />
                                </Rectangle.Effect>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RadarScanTransform" Y="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border VerticalAlignment="Bottom" Background="#DD071513" Padding="14,11"
                                    BorderBrush="#405D56" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="KHÔNG CHỈ LÀ MỘT CHẤM ĐỎ"
                                                   Foreground="#F1C55B" FontFamily="Bahnschrift SemiCondensed"
                                                   FontSize="10.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Loài · quan hệ · cân nặng · AI"
                                                   Foreground="#B7CAC4" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="REALTIME" Foreground="#48D8C9"
                                               FontFamily="Bahnschrift" FontSize="9.5" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Rectangle Grid.Column="1" Fill="#35554F" />

                <Grid Grid.Column="2" Margin="25,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="PRO VỪA RA MẮT" Foreground="{StaticResource ReleaseTeal}"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="ISLE LIVE MAP PRO"
                                   Foreground="{StaticResource ReleaseBone}" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="34" FontWeight="Bold" Margin="-1,1,0,0" />
                        <TextBlock Text="Nhìn rõ hệ sinh thái đang chuyển động quanh bạn."
                                   Foreground="#D8E6E1" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="Theo dõi player và AI bằng dữ liệu trực tiếp từ game — trên mọi server, kể cả khi mục tiêu đang đứng yên."
                                   Foreground="{StaticResource ReleaseMuted}" FontSize="11.5"
                                   FontWeight="Medium" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,17,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,7">
                            <Ellipse Width="7" Height="7" Fill="#FF4D57" Margin="0,0,6,0" />
                            <TextBlock Text="ĂN THỊT" Foreground="#D5E1DD" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,7">
                            <Ellipse Width="7" Height="7" Fill="#2FDA79" Margin="0,0,6,0" />
                            <TextBlock Text="CÙNG LOÀI" Foreground="#D5E1DD" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,7">
                            <Ellipse Width="7" Height="7" Fill="#38A8FF" Margin="0,0,6,0" />
                            <TextBlock Text="ĂN CỎ" Foreground="#D5E1DD" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse Width="7" Height="7" Fill="#F2BC3F" Margin="0,0,6,0" />
                            <TextBlock Text="AI" Foreground="#D5E1DD" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Row="2">
                        <Grid Height="49">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="#FF4D57" RadiusX="1" RadiusY="1" Margin="0,7" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PLAYER ĐÃ XÁC MINH" Foreground="#EDF5F0" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="Ghép actor với danh tính ingame để loại marker bóng ma." Foreground="#879E97" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#263F3A" />
                        <Grid Height="49">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="#F2BC3F" RadiusX="1" RadiusY="1" Margin="0,7" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AI TÁCH BIỆT" Foreground="#EDF5F0" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="Coel và AI đã xác minh hiển thị vàng, không trộn với player." Foreground="#879E97" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#263F3A" />
                        <Grid Height="49">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="#48D8C9" RadiusX="1" RadiusY="1" Margin="0,7" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LOÀI + CÂN NẶNG" Foreground="#EDF5F0" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="Nhãn gọn như T-Rex 12T, Trice 200K, Stego 6T." Foreground="#879E97" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#263F3A" />
                        <Grid Height="49">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Rectangle Fill="#7C9B94" RadiusX="1" RadiusY="1" Margin="0,7" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MỌI SERVER · MỘT LIVE MAP" Foreground="#EDF5F0" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="Không phụ thuộc website map hoặc plugin của server." Foreground="#879E97" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuietButton}" Content="ĐỂ SAU"
                                Padding="6,10" Click="CloseButton_Click"
                                AutomationProperties.Name="Đóng và xem sau" />
                        <TextBlock Grid.Column="1" Text="PRO THEO STEAMID64"
                                   Foreground="#6F8A83" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button x:Name="EnterToolButton" Grid.Column="2" Style="{StaticResource ReleaseButton}"
                                Content="XEM PRO TRÊN HOME  →" Height="43" Padding="17,0"
                                IsDefault="True" AutomationProperties.Name="Xem khu vực kích hoạt Pro"
                                Click="ShowProButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
