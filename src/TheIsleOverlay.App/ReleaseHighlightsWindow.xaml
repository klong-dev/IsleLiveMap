<Window x:Class="TheIsleOverlay.App.ReleaseHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Có gì mới trong Isle Live Map"
        Width="1000" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="#93A79F"
        TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#F2F4EC" />
        <SolidColorBrush x:Key="Muted" Color="#91A49D" />
        <SolidColorBrush x:Key="Mint" Color="#58D9BC" />
        <SolidColorBrush x:Key="Gold" Color="#F1C75B" />
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#161304" />
            <Setter Property="Background" Value="#F1C75B" />
            <Setter Property="BorderBrush" Value="#FFE49A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFE184" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D6A83E" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#C9D6D1" />
            <Setter Property="Background" Value="#101F1B" />
            <Setter Property="BorderBrush" Value="#3C5B52" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#91A49D" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutKey" TargetType="Border">
            <Setter Property="Background" Value="#CC071310" /><Setter Property="BorderBrush" Value="#4B665E" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,6" /><Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="FreeTag" TargetType="Border">
            <Setter Property="Background" Value="#152A24" /><Setter Property="BorderBrush" Value="#4B8173" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,4" /><Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ProTag" TargetType="Border" BasedOn="{StaticResource FreeTag}">
            <Setter Property="Background" Value="#332B13" /><Setter Property="BorderBrush" Value="#8E793D" />
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FD071411" BorderBrush="#685D716B" BorderThickness="1" CornerRadius="7">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.86" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" BorderBrush="#315049" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18"><Ellipse Width="16" Height="16" Stroke="#F1C75B" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#58D9BC" /></Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD UPDATE // 04 BRIEFINGS" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="TitleVersionLabel" Text="   ISLE LIVE MAP · v1.4.3" Foreground="#718A83" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="×" Width="30" Height="26" FontSize="16" AutomationProperties.Name="Đóng; lần sau vẫn hiện" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Background="#0B1B17" BorderBrush="#315049" BorderThickness="0,0,1,0">
                <Grid Margin="20,22,18,21">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Gold}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="FIELD BRIEFING" Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" />
                        <TextBlock Text="Đi hết 4 mục để xem đủ thay đổi." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,27,0,0">
                        <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepOneMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="1" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="FREE CONTROL" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Pan · reset · move block" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepTwoMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="2" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="PRO SET POINT" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="ALT + M · team share" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepThreeMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="3" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="PRO ZONES" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Migration · Patrol · food" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                        <Grid Height="50"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="StepFourMarker" Width="25" Height="25" BorderThickness="1" CornerRadius="13"><TextBlock Text="4" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="LIVE TRACKING" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Player accuracy update" Foreground="#657E76" FontSize="9.5" /></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE · CHO MỌI USER" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                        <Border Style="{StaticResource ProTag}" Margin="0,7,0,0"><TextBlock Text="PRO · CẦN PRO ACCESS" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ReleaseContent" Grid.Row="1" Grid.Column="1" Margin="28,24,28,18" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="ReleaseEntranceTransform" Y="10" /></Grid.RenderTransform>
                <Grid x:Name="PageOne">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource FreeTag}"><TextBlock Text="FREE UPDATE" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border>
                        <TextBlock Text="MAP TỰ DO HƠN. HUD GỌN HƠN." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="31" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock Text="Các thao tác nền tảng này có sẵn cho toàn bộ người dùng Free lẫn Pro." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="#36564E" BorderThickness="1" Background="#0D211C" Padding="18"><StackPanel><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="ALT + KÉO GIỮ CHUỘT TRÁI" Foreground="#F2F4EC" FontFamily="Bahnschrift" FontSize="10.5" FontWeight="Bold" /></Border><TextBlock Text="DI CHUYỂN MAP TỰ DO" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,5" /><TextBlock Text="Giữ ALT, kéo chuột trái để quan sát khu vực khác mà không làm mất vị trí GPS." Foreground="#90A49C" FontSize="10.5" TextWrapping="Wrap" LineHeight="16" /></StackPanel></Border>
                        <Border Grid.Column="2" BorderBrush="#36564E" BorderThickness="1" Background="#0D211C" Padding="18"><StackPanel><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="ALT + CHUỘT PHẢI" Foreground="#F2F4EC" FontFamily="Bahnschrift" FontSize="10.5" FontWeight="Bold" /></Border><TextBlock Text="ĐƯA MAP VỀ CHÍNH GIỮA" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,5" /><TextBlock Text="Một thao tác để thoát Free Look và đưa con trỏ của bạn trở lại trung tâm map." Foreground="#90A49C" FontSize="10.5" TextWrapping="Wrap" LineHeight="16" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#66592D" BorderThickness="1" Background="#241F0E" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource ShortcutKey}" BorderBrush="#8A753A" VerticalAlignment="Center"><TextBlock Text="CTRL + SHIFT + O" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" /></Border><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="DI CHUYỂN TỪNG BLOCK ĐỘC LẬP" Foreground="#FFE18A" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Map, status, team và nhiệm vụ không còn bị kéo thành cả cụm." Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Grid></Border>
                </Grid>

                <Grid x:Name="PageTwo" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · ALT + M" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="CLICK MỘT ĐIỂM. CẢ NHÓM CÙNG BIẾT." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" /><TextBlock Text="Mở map lớn để đặt set point chiến thuật và chia sẻ mốc với đồng đội trong nhóm sinh tồn." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,5,0,0" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="18" /><ColumnDefinition Width=".75*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="#536A62" BorderThickness="1" Background="#091A16" ClipToBounds="True"><Grid><Image Source="Assets/SetPointTip.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Minh họa đặt set point bằng ALT M" /><Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#E2071513" Padding="10,7"><TextBlock Text="ẢNH THAO TÁC THỰC TẾ" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border></Grid></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="01 · NHẤN ALT + M" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Map lớn mở ra trên màn hình." Foreground="#8FA29B" FontSize="10.5" Margin="0,4,0,16" /><TextBlock Text="02 · CLICK ĐIỂM MUỐN ĐẶT" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Chọn biểu tượng và ghi chú phù hợp." Foreground="#8FA29B" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,16" /><TextBlock Text="03 · CHIA SẺ CHO NHÓM" Foreground="#FFE18A" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Đồng đội cùng nhìn thấy mốc trên map của họ." Foreground="#AFA680" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="PageThree" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · MAP ZONES" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="ĐỌC ĐỊA HÌNH TRƯỚC KHI HẠ CÁNH." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" /><TextBlock Text="Zone được vẽ trực tiếp trên map để bạn lên tuyến di chuyển, tìm thức ăn và tránh bay vòng vô định." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,5,0,0" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="18" /><ColumnDefinition Width=".75*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="#7F6E37" BorderThickness="1" Background="#091A16" ClipToBounds="True"><Grid><Image Source="Assets/MapZoneTip.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Minh họa các zone trên minimap" /><Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#E2071513" Padding="10,7"><TextBlock Text="ZONE LAYER · LOCAL MAP" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="8.5" FontWeight="Bold" /></Border></Grid></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="MIGRATION" Foreground="#FFE18A" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Vùng di cư và hành lang sinh tồn được khoanh rõ." Foreground="#9FAF9F" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,18" /><TextBlock Text="PATROL" Foreground="#8FE3D0" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Theo dõi khu vực tuần tra ngay trong gameplay." Foreground="#9FAF9F" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,18" /><TextBlock Text="FOOD SOURCES" Foreground="#76C6FF" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Vùng thức ăn là lớp local ổn định trên map." Foreground="#9FAF9F" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="PageFour" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><Border Style="{StaticResource ProTag}"><TextBlock Text="PRO · LIVE TRACKING UPDATE" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /></Border><TextBlock Text="PLAYER ĐƯỢC DỰNG NHANH VÀ ĐỦ HƠN." Foreground="{StaticResource Bone}" FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" /><TextBlock Text="Pipeline nhận diện mới ghép nhiều mảnh replication thay vì chỉ chờ một packet hoàn chỉnh." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,5,0,0" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="#36564E" BorderThickness="1" Background="#0D211C" Padding="17"><StackPanel><TextBlock Text="FREE" Foreground="#8FE3D0" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /><TextBlock Text="Điều khiển map + layout" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="ALT + kéo trái · ALT + chuột phải · Ctrl + Shift + O" Foreground="#8FA29B" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" BorderBrush="#81703A" BorderThickness="1" Background="#241F0E" Padding="17"><StackPanel><TextBlock Text="PRO" Foreground="#FFE18A" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" /><TextBlock Text="Tactical map intelligence" Foreground="#F2F4EC" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="Player + AI · ALT + M · team set point · zones" Foreground="#B4AA86" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,13,0,0" BorderBrush="#405D55" BorderThickness="1" Background="#0A1A16" Padding="18"><StackPanel><TextBlock Text="BẠN ĐÃ XEM ĐỦ 4 MỤC" Foreground="#58D9BC" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Các thay đổi Free có sẵn ngay. Tính năng mang nhãn Pro chỉ hoạt động khi SteamID64 còn Pro access." Foreground="#91A49D" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
                    <CheckBox x:Name="DoNotShowAgainCheckBox" Grid.Row="3" Content="Không hiển thị lại thông báo này cho phiên bản 1.4.3" Foreground="#C6D2CD" FontSize="11" FontWeight="SemiBold" Margin="1,17,0,0" VerticalContentAlignment="Center" AutomationProperties.Name="Không hiển thị lại thông báo phiên bản 1.4.3" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1" Margin="28,0,28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Content="←  QUAY LẠI" Width="104" Height="40" Visibility="Hidden" Click="BackButton_Click" />
                <TextBlock x:Name="PageProgressLabel" Grid.Column="1" Text="01 / 04" Foreground="#6E8780" FontFamily="Bahnschrift" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Button x:Name="OpenProButton" Grid.Column="2" Style="{StaticResource QuietButton}" Content="XEM CÁC GÓI PRO" Height="40" Padding="12,0" Margin="0,0,10,0" Visibility="Collapsed" Click="ShowProButton_Click" />
                <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="TIẾP THEO  →" Height="40" MinWidth="122" Click="NextButton_Click" />
                <Button x:Name="FinishButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="HOÀN TẤT" Height="40" MinWidth="122" Visibility="Collapsed" IsDefault="True" Click="FinishButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
