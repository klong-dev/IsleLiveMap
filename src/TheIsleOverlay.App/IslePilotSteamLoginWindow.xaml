<Window x:Class="TheIsleOverlay.App.IslePilotSteamLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng nhập Steam · IslePilot" Width="1060" Height="760"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#071716" Foreground="#E9F4EE"
        FontFamily="Segoe UI Variable Text"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Background="#0B201E" BorderBrush="#35554F" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ĐĂNG NHẬP STEAM MỘT LẦN"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tự nhận server IslePilot đang chơi"
                               Foreground="#78938C" FontSize="10.5" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="READ-ONLY TELEMETRY" Foreground="#37D4C6"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="10"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="/me · /map · /ows" Foreground="#638078"
                               FontFamily="Bahnschrift" FontSize="9" Margin="0,3,0,0"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12" Background="#0A1A19"
                BorderBrush="#35554F" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="LoginBrowser" />
                <Border x:Name="BrowserLoadingPanel" Background="#F2071716">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="24" Height="24" Stroke="#37D4C6" StrokeThickness="2" />
                        <TextBlock Text="ĐANG MỞ ĐĂNG NHẬP STEAM…"
                                   Foreground="#8DA69F" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="10" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0B201E" BorderBrush="#35554F" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginStatusLabel"
                           Text="Đăng nhập tại Steam. Token chỉ được lưu mã hóa cho tài khoản Windows hiện tại."
                           Foreground="#78938C" FontSize="10.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="THỬ LẠI" Padding="15,7" Margin="10,0,0,0"
                        Click="RetryButton_Click" Background="#173F3A" Foreground="#E9F4EE"
                        BorderBrush="#4F8177" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
                <Button Grid.Column="2" Content="HỦY" Padding="15,7" Margin="8,0,0,0"
                        Click="CancelButton_Click" Background="Transparent" Foreground="#A8BBB5"
                        BorderBrush="#48655F" FontFamily="Bahnschrift SemiCondensed" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
