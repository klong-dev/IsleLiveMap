<Window x:Class="TheIsleOverlay.App.HomeReleaseNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Release note" Width="520" Height="440" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="#F00E1918" BorderBrush="#4C786F" BorderThickness="1" CornerRadius="10" Padding="28">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Opacity="0.6" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="VersionLabel" Foreground="#47D2C1" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="TitleLabel" Foreground="#EFF7F2" FontSize="25" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Width="34" Height="34" HorizontalAlignment="Right" Click="Close_Click"
                        Foreground="#A9BDB6" Background="Transparent" BorderThickness="0" FontSize="22" />
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,24,0,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SummaryLabel" Foreground="#C0D0CA" FontSize="14" TextWrapping="Wrap" />
                    <ItemsControl x:Name="DetailsList" Margin="0,22,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="•" Foreground="#47D2C1" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding}" Foreground="#E6F0EB" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="2" Content="ĐÓNG" HorizontalAlignment="Right" Padding="18,9" Click="Close_Click"
                    Foreground="#EFF7F2" Background="#1B5B53" BorderBrush="#3A8F83" BorderThickness="1" />
        </Grid>
    </Border>
</Window>
