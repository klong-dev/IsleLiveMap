<Window x:Class="TheIsleOverlay.App.KLongServicesAdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Live Map · Kênh thông báo Zalo"
        Width="920" Height="650"
        WindowStyle="None" ResizeMode="NoResize" Background="#05090D"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="InviteInk" Color="#05090D" />
        <SolidColorBrush x:Key="InviteBone" Color="#F3F8FA" />
        <SolidColorBrush x:Key="InviteMuted" Color="#98AEB8" />
        <SolidColorBrush x:Key="InviteSubtle" Color="#68808B" />
        <SolidColorBrush x:Key="InviteLine" Color="#1D3F50" />
        <SolidColorBrush x:Key="InviteBlue" Color="#58B7F4" />
        <SolidColorBrush x:Key="ZaloBlue" Color="#0868FF" />

        <Style x:Key="InvitePrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ZaloBlue}" />
            <Setter Property="BorderBrush" Value="#428DFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="19,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#267EFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0752CC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#172832" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#28414D" />
                                <Setter Property="Foreground" Value="#6F8791" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InviteQuietButton" TargetType="Button" BasedOn="{StaticResource InvitePrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource InviteBone}" />
            <Setter Property="Background" Value="#0C1820" />
            <Setter Property="BorderBrush" Value="{StaticResource InviteLine}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#315668" BorderThickness="1" Background="{StaticResource InviteInk}">
        <Grid x:Name="AdContent" Opacity="0">
            <Grid.RenderTransform><TranslateTransform x:Name="AdEntranceTransform" Y="12" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource InviteLine}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource ZaloBlue}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ISLE LIVE MAP  /  CỘNG ĐỒNG"
                               Foreground="{StaticResource InviteBone}" FontFamily="Bahnschrift" FontSize="10.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
                    <TextBlock Grid.Column="2" Text="KÊNH THÔNG BÁO CHÍNH THỨC · 05s"
                               Foreground="{StaticResource InviteSubtle}" FontFamily="Bahnschrift" FontSize="9.5" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="38,30,38,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*" /><ColumnDefinition Width="42" /><ColumnDefinition Width="0.98*" /></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="THAM GIA KÊNH&#x0a;THÔNG BÁO" Foreground="{StaticResource InviteBone}"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="40" FontWeight="Bold" LineHeight="42" />
                    <Border Grid.Row="1" Width="74" Height="4" HorizontalAlignment="Left"
                            Background="{StaticResource InviteBlue}" Margin="0,18,0,0" />
                    <TextBlock Grid.Row="2" Text="ĐÓNG GÓP Ý KIẾN CÁ NHÂN&#x0a;&amp; BÁO LỖI TRỰC TIẾP CHO LONG"
                               Foreground="{StaticResource InviteBlue}" FontFamily="Bahnschrift SemiCondensed"
                               FontSize="18" FontWeight="Bold" LineHeight="22" Margin="0,17,0,0" />

                    <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,18,18,8">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" Background="#102940" BorderBrush="#2A6FA4" BorderThickness="1" CornerRadius="12">
                                <TextBlock Text="01" Foreground="{StaticResource InviteBlue}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="NHẬN THÔNG BÁO SỚM" Foreground="{StaticResource InviteBone}" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Cập nhật, bảo trì và hướng dẫn sử dụng Live Map." Foreground="{StaticResource InviteMuted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" Background="#102940" BorderBrush="#2A6FA4" BorderThickness="1" CornerRadius="12">
                                <TextBlock Text="02" Foreground="{StaticResource InviteBlue}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GÓP Ý TÍNH NĂNG" Foreground="{StaticResource InviteBone}" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Đề xuất trải nghiệm bạn muốn có trong bản tiếp theo." Foreground="{StaticResource InviteMuted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" Background="#102940" BorderBrush="#2A6FA4" BorderThickness="1" CornerRadius="12">
                                <TextBlock Text="03" Foreground="{StaticResource InviteBlue}" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BÁO LỖI NHANH CHO LONG" Foreground="{StaticResource InviteBone}" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Gửi tình trạng thực tế để lỗi được xác minh và xử lý sớm." Foreground="{StaticResource InviteMuted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Nhóm dành cho người dùng Free và Pro."
                               Foreground="{StaticResource InviteSubtle}" FontSize="10" FontStyle="Italic" />
                </Grid>

                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource InviteLine}" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="QUÉT QR BẰNG ZALO ĐỂ THAM GIA" Foreground="{StaticResource InviteBone}"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                    <Border Grid.Row="1" Width="286" Height="378" Margin="0,14,0,12" Background="#F5FAFF"
                            BorderBrush="#4A98D7" BorderThickness="1" CornerRadius="8" Padding="6">
                        <Image Source="Assets/ZaloChannelInvite.jpg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Grid.Row="2" Text="Mở Zalo  →  Quét mã QR  →  Tham gia nhóm"
                               Foreground="{StaticResource InviteMuted}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource InviteLine}" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CountdownLabel" Text="CÓ THỂ ĐÓNG SAU 5 GIÂY" Foreground="{StaticResource InviteMuted}"
                                   FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold" />
                        <ProgressBar x:Name="CountdownProgress" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,9,0,0"
                                     Foreground="{StaticResource InviteBlue}" Background="#142630" BorderThickness="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NeverShowAgainButton" Style="{StaticResource InviteQuietButton}"
                                Content="KHÔNG HIỂN THỊ LẠI NỮA" MinWidth="196" IsEnabled="False"
                                Click="NeverShowAgainButton_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource InvitePrimaryButton}"
                                Content="ĐÓNG SAU 5 GIÂY" MinWidth="158" Margin="10,0,0,0"
                                IsEnabled="False" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
