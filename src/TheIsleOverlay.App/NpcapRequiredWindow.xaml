<Window x:Class="TheIsleOverlay.App.NpcapRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cần Npcap" Width="448" Height="286"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PromptButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#DCEBE6" />
            <Setter Property="Background" Value="#122C28" />
            <Setter Property="BorderBrush" Value="#466D65" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1A403A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#25584F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="#FA071716" BorderBrush="#725A7F77"
            BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.72" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#31544D" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="#173A35" Stroke="#37D4C6" StrokeThickness="1.4" />
                    <TextBlock Grid.Column="1" Text="LOCAL CAPTURE / SETUP" Foreground="#91AAA3"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                    <Button Grid.Column="2" Style="{StaticResource PromptButton}" Content="×"
                            Width="27" Height="23" Padding="0" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#37D4C6" RadiusX="1" RadiusY="1" />
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CẦN NPCAP" Foreground="#E9F4EE"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="Bold" />
                    <TextBlock Grid.Row="1"
                               Text="Isle Live Map dùng Npcap để đọc movement trên chính máy bạn. Không inject và không đọc bộ nhớ game."
                               Foreground="#AEC1BB" FontSize="12" FontWeight="Medium"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="2" Text="Cài miễn phí từ trang chính thức, sau đó mở lại app."
                               Foreground="#7F9B93" FontSize="11" FontWeight="Medium"
                               VerticalAlignment="Top" Margin="0,9,0,0" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PromptButton}" Content="ĐỂ SAU"
                                Click="CloseButton_Click" />
                        <Button Style="{StaticResource PromptButton}" Content="MỞ TRANG TẢI  →"
                                Foreground="#E8FFFA" Background="#193E38" BorderBrush="#4A9588"
                                Margin="8,0,0,0" Click="DownloadButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
