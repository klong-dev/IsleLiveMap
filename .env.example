# Development-only direct overlay mode. Public builds open Home first.
ISLELIVEMAP_DEV_AUTO_CONNECT=1

# Choose "era", "dinovietnam", or "dinovietnampremium". Never commit real cookie values.
TELEMETRY_SOURCE=era
ERA_SESSION=replace_with_your_era_session_value
ISLEPILOT_PLAYER=replace_with_your_islepilot_player_value
ISLEPILOT_PREMIUM_PLAYER=replace_with_your_premium_islepilot_player_value
